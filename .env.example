# Copy to .env for local development. Never commit .env.

# --- database (apps/ropa-api) ---
DATABASE_URL=postgres://ropa:ropa@localhost:5432/ropa

# --- auth (docs/ropa/ropa-api.md §1.9) ---
JWT_SECRET=dev-only-change-me
TOKEN_MINT_SECRET=dev-only-change-me
PRINCIPALS=[{"sub":"priya.raman","name":"Priya Raman","roles":["editor","approver"]},{"sub":"tomas.herrera","name":"Tomas Herrera","roles":["editor"]},{"sub":"svc:seed","name":"Demo data loader","roles":["admin"]}]
REQUIRE_AUTH_FOR_READS=false
AUTH_DISABLED=false

# --- service ---
PORT=3000
LOG_LEVEL=debug

# --- frontend (apps/ropa-web) ---
ROPA_API_URL=http://localhost:3000
