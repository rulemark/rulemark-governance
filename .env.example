# Copy to .env for local development. Never commit .env.

# --- database (apps/ropa-api) ---
DATABASE_URL=postgres://ropa:ropa@localhost:5432/ropa

# --- auth (docs/ropa/ropa-api.md §1.9) ---
JWT_SECRET=dev-only-change-me
TOKEN_MINT_SECRET=dev-only-change-me
PRINCIPALS=[{"sub":"priya.raman","name":"Priya Raman","roles":["editor","approver"]},{"sub":"tomas.herrera","name":"Tomas Herrera","roles":["editor"]},{"sub":"svc:seed","name":"Demo data loader","roles":["admin"]},{"sub":"svc:schedule","name":"Coverage job","roles":["service:schedule"]}]
REQUIRE_AUTH_FOR_READS=false
AUTH_DISABLED=false

# --- events (docs/ropa/ropa-api.md §6) ---
# Where each consumer lives: host:port (as Render wires it) or a URL. Unset,
# its events wait in the outbox. Start apps/audit-log locally to receive them.
# EVENT_DESTINATION_AUDIT_LOG=localhost:4000
# EVENT_DESTINATION_MONITOR=localhost:4001

# --- service ---
PORT=3000
LOG_LEVEL=debug

# --- frontend (apps/ropa-web), and the coverage job ---
# Where the API is: a URL, or host:port as Render wires it.
ROPA_API_URL=http://localhost:3000
