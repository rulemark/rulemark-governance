{
  "name": "@rulemark/audit-log",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A stand-in for the audit log: receives RoPA's events, logs them, and ignores repeats",
  "license": "UNLICENSED",
  "dependencies": {
    "@rulemark/ropa-schemas": "*",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.13"
  }
}
