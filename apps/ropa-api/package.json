{
  "name": "@rulemark/ropa-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "RoPA service: Express + Drizzle + Postgres",
  "license": "UNLICENSED",
  "dependencies": {
    "@rulemark/ropa-schemas": "*",
    "dotenv": "^18.0.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jose": "^6.2.12",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc --build",
    "start": "node dist/index.js",
    "typecheck": "tsc --build",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dist": "vitest run --config vitest.dist.config.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "openapi:write": "node dist/api/openapi/write.js",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "^5.0.1",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13"
  }
}
